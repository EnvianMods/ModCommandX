{
  "name": "mod-command-x",
  "productName": "Mod Command X",
  "version": "1.0.1",
  "modCommandCompat": "1.9.14",
  "description": "Mod Command X — a private side-by-side build of Zero Company Mod Command",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "fetch-tools": "node build/fetch-tools.js",
    "build-exe": "node build/fetch-tools.js && electron-builder --win portable --publish never",
    "build": "npm ci --no-audit --no-fund && node build/fetch-tools.js && electron-builder --win portable --publish never",
    "build-uninstaller": "node build/build-uninstaller.js"
  },
  "author": "Fulme",
  "license": "MIT",
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "electron": "^44.4.5",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "build": {
    "appId": "com.zerocompany.modcommandx",
    "productName": "Mod Command X",
    "afterPack": "build/after-pack.js",
    "beforePack": "build/before-pack.js",
    "afterAllArtifactBuild": "build/after-all-artifacts.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "**/*",
          "!oo2core*.dll"
        ]
      },
      {
        "from": "build/uninstaller",
        "to": "uninstaller",
        "filter": [
          "bin/Uninstall Mod Command X.exe",
          "uninstall-linux.sh"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "ModCommandX.exe",
      "unpackDirName": "ModCommandX"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "artifactName": "ModCommandX.AppImage",
      "category": "Utility",
      "executableName": "mod-command-x"
    }
  }
}
