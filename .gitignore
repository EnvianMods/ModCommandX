# Dependencies and build output
node_modules/
release/

# Local user data (settings, Nexus API key, installed mod library)
data/

# Secrets — never commit credentials of any kind
owner-tools/**/*token*.txt
owner-tools/**/nexus-key.txt
token.txt

# Backups and temp
*.zcbak
*.log
/ModCommandX.exe

# Internal working notes - lives in the archive repo at docs/HANDOFF.md, never published
HANDOFF.md
*.lnk

# Environment files that may carry tokens
.env
.env.*

# Uninstaller build output (build/build-uninstaller.js)
build/uninstaller/bin/
build/uninstaller/obj/
/Uninstall Mod Command X.exe

# Epic/RAD's Oodle dll is not ours to redistribute - never bundle it
tools/oo2core*.dll

# Owner-only and internal files - kept locally, never on the public repo
# (package-source-release.js packs only git-tracked files; publish-release.js
# refuses a zip that carries any of these)
/owner-tools/
/reference/
/RELEASING.md
HANDOFF*
/DESCRIPTION.txt
/RELEASE_VERSION.txt
/docs/SDK_LINK.md
/build/make-icon.py
/build/icon-1024.png
/mod-placeholder-640.png
/mod-placeholder-1280.png
/docs/screenshots/
